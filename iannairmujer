Procedure ListarProducto; {Listar Producto}
begin

  assign(archivo, 'inventario.dat');
  {$I-} 
  reset(archivo); 
  {$I+}

  if IOResult <> 0 then
  begin
    writeln('El inventario esta vacio.');
    exit;
  end;

  writeln('=== Inventario ===');
  while not eof(archivo) do
  begin
    read(archivo, producto);
    writeln('Codigo : ', producto.codigo);
    writeln('Descripcion.  : ', producto.descripcion);
    writeln('Precio : $', producto.precio:0:2);
    writeln('Stock  : ', producto.stock, ' unidades');
    writeln;
  end;
  close(archivo);
  readln();
end;

Procedure EditarProducto; {Edita el producto}
var edit: string;
begin
  writeln('Ingrese la descripcion del producto a editar: ');
  ReadLn(edit)
  LimpearTildes_y_Mayusculas(edit)
  
  assign(archivo, 'inventario.dat');  {Se asigna el archivo al que se va a escribir}
  {$I-}  {Se deshabilitan los mensajes de error}
  reset(archivo);  {Se intenta abrir el archivo para lectura}
  {$I+}  {Se vuelven a habilitar los mensajes de error}
  
  BuscarPorDescripcion;



end;


begin
